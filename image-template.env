# atomic-workstation — image build parameters
# Consumed by the image-* recipes in the justfile and by CI
# (.github/workflows/build.yml). Mirrors ublue-os/image-template.

# output image name (must be lowercase for GHCR)
IMAGE_NAME=atomic-workstation

# GitHub user/org that owns the registry namespace
REPO_ORGANIZATION=lynimbus

# git repository hosting this build (used in the image labels)
SOURCE_REPO=lynimbus/dotfiles

IMAGE_DESC="Bazzite with an additional Sway session, kept in sync from a dotfiles repo"
IMAGE_KEYWORDS="bazzite,sway,bootc,flatpak,atomic"

# optional: logo shown on https://artifacthub.io/
IMAGE_LOGO_URL=""

DEFAULT_TAG=latest

# image used by the qcow2/disk builds (bootc-image-builder)
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"

# Base image variant — see the Containerfile for the full list.
#   AMD/Intel: ghcr.io/ublue-os/bazzite:stable   (default)
#   NVIDIA:    ghcr.io/ublue-os/bazzite-nvidia:stable
BASE_IMAGE=ghcr.io/ublue-os/bazzite-nvidia-open:stable
