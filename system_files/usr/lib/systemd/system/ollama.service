# /usr/lib/systemd/system/ollama.service — atomic-workstation
#
# Shipped by this repo because build_files/build.sh no longer installs Fedora's
# `ollama-base` package: Fedora 45 ships ollama 0.24.0 while the configured
# model (`kev:4b-q4_K_M`) requires >= 0.40.4, so the payload comes from the
# pinned upstream release instead (see build_files/build.sh). The unit that
# package used to own is reproduced here, so `systemctl enable ollama.service`
# and the `atomic-workstation` drop-in (10-lynimbus.conf) keep working.
#
# The upstream release ships no unit of its own (only bin/ + lib/), so this
# file plus /usr/lib/sysusers.d/ollama.conf are the two integration files the
# Fedora package used to provide.

[Unit]
Description=Ollama Service
After=network-online.target

[Service]
# OLLAMA_HOST: IP/port Ollama binds to. Keep this on loopback: binding to
# 0.0.0.0 or [::] exposes the model server to the network.
Environment="OLLAMA_HOST=127.0.0.1:11434"
# Use the integrated GPU as well as the discrete one (Fedora's package set
# this too; OLLAMA_VULKAN=1 comes from the drop-in).
Environment="OLLAMA_IGPU_ENABLE=1"

ExecStart=/usr/bin/ollama serve
User=ollama
Group=ollama
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
