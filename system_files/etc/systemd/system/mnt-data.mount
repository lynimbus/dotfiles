# Port of system/hardware.nix (main branch):
#   fileSystems."/mnt/data" = { device = "/dev/disk/by-uuid/466A71B2AC3E8697";
#     fsType = "ntfs3"; options = [ "uid=1000" "gid=100" "windows_names" ]; };
# `nofail` is added on top of the NixOS options so a missing disk can never
# hang an image-based boot (documented deviation in docs/nixos-port-map.md).

[Unit]
Description=Data partition (/mnt/data)

[Mount]
What=/dev/disk/by-uuid/466A71B2AC3E8697
Where=/mnt/data
Type=ntfs3
Options=uid=1000,gid=100,windows_names,nofail

[Install]
WantedBy=local-fs.target
