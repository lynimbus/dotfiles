# atomic-workstation backup configuration — EXAMPLE
#
# Copy to ~/.config/atomic-workstation/backup.env (recommended) or to a
# repo-local .env (gitignored). Consumed by scripts/backup.sh.
# NEVER put a literal password in here — use a password file or command.

# restic destination: local path, sftp:, s3:, b2:, rest:...
RESTIC_REPOSITORY=/mnt/backup/restic

# password via file...
RESTIC_PASSWORD_FILE=~/.config/atomic-workstation/restic-password
# ...or via a command (e.g. secret storage)
# RESTIC_PASSWORD_COMMAND=secret-tool lookup backup restic

# what to back up (space separated, ~ is expanded); default shown
# BACKUP_PATHS="$HOME/Documents $HOME/Pictures"

# extra excludes (one pattern per line, ~ is expanded); default shown
# BACKUP_EXCLUDES="
# **/.cache
# **/node_modules
# **/__pycache__
# **/.venv
# **/target
# "
