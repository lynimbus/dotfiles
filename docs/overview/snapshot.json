        },
        "rerere": {
          "enabled": true
        },
        "user": {
          "email": "128837704+lynimbus@users.noreply.github.com",
          "name": "lynimbus"
        }
      }
    },
    "jujutsu": {
      "enable": true,
      "settings": {
        "aliases": {
          "delta": [
            "diff",
            "--git",
            "--config",
            "ui.pager=[\"delta\", \"--navigate\"]"
          ]
        },
        "git": {
          "colocate": false,
          "private-commits": "description(glob:'wip:*') | description(glob:'private:*')"
        },
        "revset-aliases": {
          "immutable_heads()": "untracked_remote_bookmarks()"
        },
        "revsets": {
          "git-sign-on-push": "~signed() & mine()"
        },
        "signing": {
          "backend": "ssh",
          "key": "/home/lynimbus/.ssh/id_ed25519"
        },
        "ui": {
          "default-command": "log",
          "diff-editor": ":builtin",
          "diff-formatter": "difft",
          "merge-editor": "meld"
        },
        "user": {
          "email": "128837704+lynimbus@users.noreply.github.com",
          "name": "lynimbus"
        }
      }
    },
