root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{sh,bash,py}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json,jsonc,toml,ini,cfg}]
indent_style = space
indent_size = 2

[*.{css,js}]
indent_style = space
indent_size = 2

[{justfile,Justfile,*.just}]
indent_style = space
indent_size = 4

[{Containerfile,Dockerfile}]
indent_style = space
indent_size = 4
