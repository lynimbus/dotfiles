// =============================================================================
// Niri 快捷键配置文件 / Niri Keybindings Configuration
// =============================================================================
// 本配置文件包含 Niri 窗口管理器的所有键盘、鼠标与快捷键绑定。
// This config file contains all keyboard, mouse, and shortcut keybindings for Niri.
// =============================================================================

binds {
    // -------------------------------------------------------------------------
    // 1. 会话与系统控制 / Session & System Controls
    // -------------------------------------------------------------------------
    // 切换概览视角 (禁止按键重复) / Toggle workspace overview (prevent key repeat)
    Mod+Tab repeat=false { toggle-overview; }

    // 关闭当前获得焦点的窗口 / Close active focused window
    // chromium 走 SIGTERM 优雅退出(写 exit_type=Normal), 其余应用走 close-window
    Mod+Q { spawn "~/.config/niri/close-focused.sh"; }

    // 退出 Niri 桌面会话 / Quit Niri desktop session
    Mod+Shift+E { quit; }

    // 重新加载 Niri 配置文件 / Reload Niri configuration file
    Mod+Shift+R { spawn "niri" "msg" "action" "load-config-file"; }

    // 锁定屏幕 (使用 Noctalia 原生锁屏) / Lock screen using Noctalia native lockscreen
    Mod+L { spawn "noctalia" "msg" "session" "lock"; }

    // 手动阻止待机/锁屏 (Noctalia caffeine, 再按一次恢复) / Toggle idle inhibitor (caffeine)
    // 生效范围: 屏蔽 noctalia 的 idle 自动锁屏(300s)与息屏(360s), 并注册 systemd idle block 抑制器。
    // 不影响合盖休眠 (走 acpid 路径, 见 AGENTS.md)。切换时有 OSD 提示。
    Mod+Shift+L hotkey-overlay-title="阻止待机/锁屏 (Caffeine)" { spawn "noctalia" "msg" "caffeine-toggle"; }

    // 显示快捷键提示覆盖层 / Show interactive hotkey overlay
    Mod+Slash { show-hotkey-overlay; }

    // -------------------------------------------------------------------------
    // 2. 应用启动与 Noctalia 组件 / App Launchers & Noctalia Panels
    // -------------------------------------------------------------------------
    // 启动终端模拟器 (本机: ghostty) / Launch terminal emulator (ghostty)
    Mod+Return { spawn "ghostty"; }

    // 启动浮动终端 (独立 app-id, 由 rules.kdl 匹配为浮动) / Launch floating terminal
    Mod+Shift+Return { spawn "ghostty" "--class=com.ghostty.float"; }

    // 启动文件管理器 (本机: thunar, pacman) / Launch file manager (thunar)
    Mod+E { spawn "thunar"; }

    // 启动浏览器 (本机: ungoogled-chromium) / Launch web browser (ungoogled-chromium)
    Mod+B { spawn "chromium"; }

    // 切换 Noctalia 应用启动器 / Toggle Noctalia application launcher
    Mod+R { spawn "noctalia" "msg" "panel-toggle" "launcher"; }

    // 切换 Noctalia 电源/会话菜单 / Toggle Noctalia power/session menu
    Mod+X { spawn "noctalia" "msg" "panel-toggle" "session"; }

    // 切换 Noctalia 系统设置面板 / Toggle Noctalia system settings panel
    Mod+I { spawn "noctalia" "msg" "settings-toggle"; }

    // 切换 Noctalia 剪贴板历史 / Toggle Noctalia clipboard history panel
    Mod+V { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }

    // 切换 Noctalia 静态壁纸选择器 / Toggle Noctalia wallpaper picker
    Mod+W { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }

    // 免打扰随机切换下一张壁纸 (主题取色自动跟随更新) / Switch to a random wallpaper immediately
    Mod+Ctrl+W { spawn "noctalia" "msg" "wallpaper-random"; }

    // mpvpaper 动态壁纸选择器: 本机未安装 mpvpaper (AUR), 如后续安装可恢复:
    // Mod+Shift+W { spawn "noctalia" "msg" "panel-toggle" "noctalia/mpvpaper:picker"; }

    // 切换护眼模式 (调暖色温并关闭透明度/毛玻璃) / Toggle eye-care mode (warmer temp & disable blur/transparency)
    Mod+N { spawn "~/.config/niri/toggle-eyecare.sh"; }
    Mod+Grave { spawn "~/.config/niri/niri-scratch-toggle.sh"; }

    // -------------------------------------------------------------------------
    // 3. 焦点导航与窗口移动 / Focus Navigation & Window Movement
    // -------------------------------------------------------------------------
    // 智能焦点导航 (达到边缘时自动穿透跨屏与跨工作区) / Smart focus (auto cross monitor & workspace)
    Mod+Left  { focus-column-or-monitor-left; }
    Mod+Right { focus-column-or-monitor-right; }
    Mod+Down  { focus-window-or-workspace-down; }
    Mod+Up    { focus-window-or-workspace-up; }

    // 左手单手焦点控制 / One-handed Left-hand Focus Controls
    Mod+Z { focus-column-left; }
    Mod+C { focus-column-right; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }

    // 智能窗口/列搬运 (推至边缘时自动搬运至相邻显示器或工作区) / Smart movement (auto move to monitor & workspace)
    Mod+Ctrl+Left  { move-column-left-or-to-monitor-left; }
    Mod+Ctrl+Right { move-column-right-or-to-monitor-right; }
    Mod+Ctrl+Down  { move-window-down-or-to-workspace-down; }
    Mod+Ctrl+Up    { move-window-up-or-to-workspace-up; }

    // Shift 辅助精准移动 / Movement with Shift modifier
    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Right { move-column-right; }

    // 工作区方向导航 / Workspace Navigation
    Mod+D { focus-workspace-down; }
    Mod+U { focus-workspace-up; }

    // 显示器精准导航与搬运 / Precision Multi-Monitor Navigation
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+Down  { move-column-to-monitor-down; }
    Mod+Shift+Ctrl+Up    { move-column-to-monitor-up; }

    // -------------------------------------------------------------------------
    // 4. 窗口布局与尺寸调整 / Window Layout & Sizing
    // -------------------------------------------------------------------------
    // 切换当前窗口的浮动/平铺状态 / Toggle window floating state
    Mod+T { toggle-window-floating; }

    // 平铺与浮动窗口之间穿透转移焦点 / Switch focus between floating and tiling layout
    Mod+Shift+T { switch-focus-between-floating-and-tiling; }

    // 切换当前列为标签页分组模式 (Tabbed Group) / Toggle column tabbed display
    Mod+G { toggle-column-tabbed-display; }

    // 最大化当前列宽度 / Maximize column width
    Mod+F { maximize-column; }

    // 全屏显示当前窗口 / Fullscreen focused window
    Mod+Shift+F { fullscreen-window; }

    // 循环切换预设列宽比例 / Switch preset column widths
    Mod+Space { switch-preset-column-width; }

    // 微调列宽与高度重置 / Fine-tune column width & reset height
    Mod+Minus { set-column-width "-5%"; }
    Mod+Equal { set-column-width "+5%"; }
    Mod+Shift+Equal { reset-window-height; }

    // 将相邻窗口合并入当前列 / Consume adjacent window into current column
    Mod+Comma { consume-window-into-column; }

    // 将当前窗口从列中分离吐出 / Expel window from current column
    Mod+Period { expel-window-from-column; }

    // -------------------------------------------------------------------------
    // 5. 工作区管理 (1-9) / Workspace Management (1-9)
    // -------------------------------------------------------------------------
    // 切换至指定编号工作区 / Switch to workspace by index
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    // 将当前列移动至指定编号工作区 / Move focused column to workspace by index
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }

    // -------------------------------------------------------------------------
    // 6. 鼠标与滚轮绑定 / Mouse & Wheel Binds
    // -------------------------------------------------------------------------
    // 滚轮上下滚动切换工作区 (带 150ms 冷却防误触) / Scroll wheel up/down to switch workspace (150ms cooldown)
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Ctrl+滚轮上下滚动携带当前列切换工作区 / Ctrl+Scroll wheel up/down to move column between workspaces
    Mod+Ctrl+WheelScrollDown cooldown-ms=150 { move-column-to-workspace-down; }
    Mod+Ctrl+WheelScrollUp   cooldown-ms=150 { move-column-to-workspace-up; }

    // 滚轮左右/Shift+滚轮切换列焦点 / Scroll wheel left/right or Shift+wheel to switch column focus
    Mod+WheelScrollRight      { focus-column-right; }
    Mod+WheelScrollLeft       { focus-column-left; }
    Mod+Shift+WheelScrollDown { focus-column-right; }
    Mod+Shift+WheelScrollUp   { focus-column-left; }

    // Ctrl+滚轮左右/Ctrl+Shift+滚轮移动当前列 / Ctrl+wheel or Ctrl+Shift+wheel to move column left/right
    Mod+Ctrl+WheelScrollRight      { move-column-right; }
    Mod+Ctrl+WheelScrollLeft       { move-column-left; }
    Mod+Ctrl+Shift+WheelScrollDown { move-column-right; }
    Mod+Ctrl+Shift+WheelScrollUp   { move-column-left; }

    // -------------------------------------------------------------------------
    // 7. 多媒体与硬件控制 / Multimedia & Hardware Control
    // -------------------------------------------------------------------------
    // 音量加 / 减 / 静音 (WirePlumber) / Volume Up / Down / Mute via WirePlumber
    XF86AudioRaiseVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%+"; }
    XF86AudioLowerVolume { spawn "wpctl" "set-volume" "@DEFAULT_AUDIO_SINK@" "5%-"; }
    XF86AudioMute        { spawn "wpctl" "set-mute" "@DEFAULT_AUDIO_SINK@" "toggle"; }

    // 屏幕亮度: 内屏优先 brightnessctl (amdgpu_bl2), 外接 DDC 显示器回退 ddcutil (允许锁屏状态下生效)
    XF86MonBrightnessUp   allow-when-locked=true { spawn "/home/lynimbus/.config/niri/backlight-up.sh"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "sh" "-c" "brightnessctl set 10%- 2>/dev/null || ddcutil setvcp 10 - 10"; }

    // -------------------------------------------------------------------------
    // 8. 截图按键控制 / Screenshot Controls
    // -------------------------------------------------------------------------
    // 交互式区域截图 / Interactive region screenshot (指针默认隐藏, 按 P 可临时显示)
    Mod+Shift+S { screenshot show-pointer=false; }
    Print       { screenshot show-pointer=false; }

    // 截取整个显示器屏幕 / Fullscreen screenshot (不带鼠标指针)
    Ctrl+Print  { screenshot-screen show-pointer=false; }

    // 截取当前活动窗口 / Active window screenshot (26.04 起默认不带指针)
    Alt+Print   { screenshot-window show-pointer=false; }
}
