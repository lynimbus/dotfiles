// =============================================================================
// 护眼模式片段 (EyeCare effects) —— 与 effects_normal.kdl 二选一，由
// toggle-eyecare.sh 通过切换 effects.kdl 符号链接 + 重载 config 应用。
// 窗口 100% 纯不透明、禁用毛玻璃与穿透，消除穿透与眩光。
//
// 注意：这里不能再有 top-level `blur` 节点（settings 已生成，重复节点会
// 拒载）。全局 blur 无法运行期关闭，改为用一条匹配所有窗口的
// background-effect { blur false } 规则按窗口逐个关掉 —— 视觉等效
// （背景采集仍会跑，GPU 开销略高可接受）。
// =============================================================================

window-rule {
    opacity 1.0
    background-effect {
        blur false
        xray false
    }
}

window-rule {
    match is-focused=false
    opacity 1.0
}
