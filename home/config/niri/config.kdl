// 引入由 nwg-displays 生成的显示器配置
include "monitor.kdl"
// 动态引入视觉特效样式 (普通模式 vs 护眼模式)
include "effects.kdl"
// 引入输入设备与手势配置 (受 Dunder Protocol 保护，更新自动保留)
include optional=true "input__custom__.kdl"
// 引入布局设置
include "layout.kdl"
// 引入动画配置
include "animations.kdl"
// 引入窗口与图层规则
include "rules.kdl"
// 引入快捷键绑定配置
include "binds.kdl"

overview {
    backdrop-color "#4c566a90"
    workspace-shadow {
        off
    }
}

environment {
    XDG_CURRENT_DESKTOP "niri"
    XDG_SESSION_TYPE "wayland"
    GTK_IM_MODULE "fcitx"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_QPA_PLATFORMTHEME "gtk3"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"

    // chromium 原生 Wayland 开关（nixpkgs 包装器读这个变量才会加
    // --ozone-platform-hint=auto）。此前未设置 → ungoogled-chromium 走 XWayland，
    // 点自绘标题栏的最小化按钮会把窗口卡死（niri 不实现 minimize，X11 客户端
    // 等不到 WM 响应，见 niri-wm/niri#3780 / #4363）。原生 Wayland 下
    // Chromium 151 的 Minimize() 是空操作，最小化按钮无害，卡死消失。
    NIXOS_OZONE_WL "1"

    // NVIDIA environment variables (本机笔记本屏由 AMD iGPU 驱动, niri 跑在 amdgpu 上,
    // 保持注释; NVIDIA 4060 仅用于 offload/CUDA, 需要时用 prime-run)
}

spawn-at-startup "noctalia"
spawn-at-startup "~/.config/niri/toggle-eyecare.sh" "--sync"
// 输入法 (fcitx5, Wayland text-input 协议)
spawn-at-startup "fcitx5" "-d"
// GTK M3 模板重渲染：冷启动后 Noctalia 需要时间算壁纸调色板，8 秒后
// 重新渲染 gtk.css（config-reload + templates-apply），确保 GTK 应用
// 尽快加载到 M3 配色（移植自上游 NyxNiri）。
spawn-at-startup "bash" "-c" "sleep 8; noctalia msg config-reload && noctalia msg templates-apply"

hotkey-overlay {
    skip-at-startup
}

prefer-no-csd
screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

debug {
    honor-xdg-activation-with-invalid-serial
}

recent-windows {
    binds {
        Alt+Tab         { next-window scope="output"; }
        Alt+Shift+Tab   { previous-window scope="output"; }
        Alt+grave       { next-window filter="app-id"; }
        Alt+Shift+grave { previous-window filter="app-id"; }
    }
    highlight {
        corner-radius 12
        active-color "#b6c7e7"
        urgent-color "#ffb4ab"
    }
}

cursor {
    xcursor-theme "Adwaita"
    xcursor-size 24
}

// ==========================================================
// 用户自定义配置 (User Custom Configuration)
// 将自定义的自启项或窗口规则写在 __custom__.kdl 中，更新时自动保留。
// 你也可以在当前目录创建 __custom__/ 文件夹放置个人脚本。
// ==========================================================
include "__custom__.kdl"
