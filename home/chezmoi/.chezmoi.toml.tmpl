{{- /*
    ~/.config/chezmoi/chezmoi.toml — generated by `chezmoi init` from home/chezmoi.
    Used when templates (e.g. waybar/config.jsonc.tmpl) need machine data.
    profile = which software inventory belongs to this machine
    (apps/flatpak/inventory/<profile>.json). Defaults to WORKSTATION_PROFILE
    or the hostname; override by editing this line after init.
*/ -}}
[data]
    profile = {{ (env "WORKSTATION_PROFILE" | default .chezmoi.hostname) | quote }}
