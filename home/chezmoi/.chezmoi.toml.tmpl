{{- /*
    ~/.config/chezmoi/chezmoi.toml — generated by `chezmoi init` from home/chezmoi.
    Used when templates need machine data.
    profile = which software inventory belongs to this machine
              (apps/flatpak/inventory/<profile>.json). Defaults to
              WORKSTATION_PROFILE or the hostname; override by editing
              this line after init.
    gitName / gitEmail = identity for ~/.config/git/config and jj
              (dot_config/git/config.tmpl, dot_config/jj/config.toml.tmpl).
*/ -}}
[data]
    profile = {{ (env "WORKSTATION_PROFILE" | default .chezmoi.hostname) | quote }}
    gitName = "lynimbus"
    gitEmail = "128837704+lynimbus@users.noreply.github.com"
