# ~/.config/ghostty/config — atomic-workstation
#
# Port of home/programs/ghostty.nix (main branch).
# ghostty is not in Fedora repos (checked 2026-11) and upstream ships no
# Linux binaries — install it with `ujust atomic-ws-user-apps` (pkgforge
# AppImage into ~/.local/bin) or build it in a distrobox. Until then foot
# remains the session's always-present fallback terminal.

font-family = Maple Mono NF CN
font-size = 13

background-opacity = 0.93
background-blur = true

window-decoration = none
maximize = true

copy-on-select = clipboard
command = fish --login
