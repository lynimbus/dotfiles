# ~/.config/mako/config — atomic-workstation
#
# Managed by chezmoi. mako is the notification daemon for the sway session
# (D-Bus activated, no autostart entry needed).

max-visible=5
timeout=5
default-timeout=5
sort=-priority

background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#89b4fa
border-size=2
padding=10
margin=10,10,10,10

# Keybinding to open the notification center (makoctl)
[mode=do-not-disturb]
invisible=1
