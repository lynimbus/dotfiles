// ~/.config/waybar/config.jsonc — atomic-workstation
//
// Managed by chezmoi. A compact default bar: workspaces | tray, clock, battery
// (hidden when absent), volume, backlight (hidden when absent).
// Style lives in style.css. Machine-specific tweaks: edit locally and commit,
// or move a block into your own file and remove it here.
{
    "layer": "top",
    "position": "top",
    "height": 30,

    "modules-left": ["sway/workspaces", "sway/mode", "tray"],
    "modules-center": ["clock"],
    "modules-right": ["pulseaudio", "backlight", "battery", "idle_inhibitor"],

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },
    "sway/mode": {
        "format": "{}"
    },
    "tray": {
        "icon-size": 18,
        "spacing": 8
    },
    "clock": {
        "format": "{:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "{:%A %Y-%m-%d | %H:%M}"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "🔇",
        "format-icons": ["🔈", "🔉", "🔊"],
        "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-click-right": "pavucontrol || true"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{percent}% ☀",
        "on-scroll-up": "brightnessctl set +5%",
        "on-scroll-down": "brightnessctl set 5%-"
    },
    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-icons": ["🔋", "🪫"]
    },
    "idle_inhibitor": {
        "format": "{icon}",
        "format-icons": {
            "activated": "🔒",
            "deactivated": "🔓"
        }
    }
}
