# ~/.bashrc — atomic-workstation
#
# Managed by chezmoi. Interactive, POSIX-friendly bash setup that works on
# the host (Bazzite) and inside distrobox containers alike.
# The user's daily driver shell is fish (kept per-machine, not managed here);
# this file is the portable fallback for bash sessions.

export ATOMIC_WORKSTATION_DIR="${ATOMIC_WORKSTATION_DIR:-$HOME/dotfiles}"
export WORKSTATION_PROFILE="${WORKSTATION_PROFILE:-}"

HISTSIZE=10000
HISTFILESIZE=20000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend checkwinsize

if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    PS1='[\u@\h \w]\$ '
fi

alias la='ls -a'
alias lla='ls -la'
alias c='clear'
alias grep='grep --color=auto'

# This MUST be here and not only in ~/.profile: a login bash reads the FIRST
# of ~/.bash_profile / ~/.bash_login / ~/.profile, and Bazzite ships a
# ~/.bash_profile (from /etc/skel) that sources ~/.bashrc but never
# ~/.profile. So the ~/.local/bin block in ~/.profile is dead code for bash.
#
# It matters beyond interactive shells: niri-session runs
# `systemctl --user import-environment`, which overwrites the user manager's
# environment.d PATH with the LOGIN SHELL's PATH. With ~/.local/bin missing
# there, every niri child (noctalia, systemd user units, desktop entries)
# loses ghostty/chromium/screenshot/magpie — the exact failure this fixes.
# fish already does this via `fish_add_path -g ~/.local/bin` in config.fish.
case ":${PATH}:" in
    *":${HOME}/.local/bin:"*) ;;
    *) export PATH="${HOME}/.local/bin:${PATH}" ;;
esac

# Bazzite installs brew system-wide for the `linuxbrew` user; ~/.linuxbrew is
# only a symlink some installers create. Check both, quietly.
for _brew_prefix in /home/linuxbrew/.linuxbrew "${HOME}/.linuxbrew"; do
    if [ -x "${_brew_prefix}/bin/brew" ]; then
        eval "$("${_brew_prefix}/bin/brew" shellenv)"
        break
    fi
done
unset _brew_prefix

export EDITOR="${EDITOR:-hx}"
export VISUAL="${VISUAL:-hx}"

[ -f ~/.bashrc.local ] && . ~/.bashrc.local
